{
  "name": "my-life-calendar",
  "version": "1.4.2",
  "description": "Life Calendar for Obsidian — a life in weeks grid with journal entries, events and JSON backup (import/export) compatible with the Life Calendar Android app.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint ."
  },
  "keywords": [
    "obsidian",
    "life-calendar",
    "life-in-weeks"
  ],
  "author": "PrEvAl85",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/parser": "^8.67.0",
    "esbuild": "^0.19.11",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "latest",
    "tslib": "2.6.2",
    "typescript": "5.3.3"
  }
}
